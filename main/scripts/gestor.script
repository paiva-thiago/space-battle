-- Controla o spawn de asteroides, pontuação e vidas

local INTERVALO_SPAWN = 1.5  -- segundos entre spawns
local RANGE_X = 4.5          -- posição X aleatória do spawn
local RANGE_Y = 3.0          -- posição Y aleatória do spawn
local Z_SPAWN = -25          -- posição Z de spawn (fundo)

function init(self)
	self.timer_spawn = 0
	self.pontuacao = 0
	self.vidas = 3
	self.timer_pontos = 0
	self.jogo_ativo = true
	print("Jogo iniciado!")
end

function update(self, dt)
	if not self.jogo_ativo then return end

	-- Timer de spawn
	self.timer_spawn = self.timer_spawn + dt
	if self.timer_spawn >= INTERVALO_SPAWN then
		self.timer_spawn = 0
		spawnar_asteroide(self)
	end

	-- Pontuação: +1 por segundo sobrevivido
	self.timer_pontos = self.timer_pontos + dt
	if self.timer_pontos >= 1 then
		self.timer_pontos = 0
		self.pontuacao = self.pontuacao + 1
		print("Pontuação: " .. self.pontuacao)
	end
end

function spawnar_asteroide(self)
	-- Posição aleatória no spawn
	local x = math.random(-RANGE_X * 10, RANGE_X * 10) / 10
	local y = math.random(-RANGE_Y * 10, RANGE_Y * 10) / 10
	local pos = vmath.vector3(x, y, Z_SPAWN)

	-- Criar asteroide via Factory
	factory.create("#factory", pos)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("colisao_nave") then
		self.vidas = self.vidas - 1
		print("Vidas restantes: " .. self.vidas)

		if self.vidas <= 0 then
			self.jogo_ativo = false
			print("GAME OVER! Pontuação: " .. self.pontuacao)
		end
	end
end